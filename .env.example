# 云盘文件管理系统 — 环境变量模板
# 复制此文件为 .env 并填入实际值

# MySQL 数据库
DB_HOST=localhost
DB_USER=drive_app
DB_PASSWORD=CHANGE_ME_APP_PASSWORD
DB_NAME=cloud_drive
DB_CONNECTION_LIMIT=10

# JWT 认证（务必修改为随机字符串）
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_STRING

# API 服务
API_PORT=8081

# 文件上传
UPLOAD_MAX_SIZE=10737418240

# CORS 允许的前端地址
CORS_ORIGIN=http://localhost:8081
